generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COOPERATIVA
  PrefeituraVendedor
  MASTER
}

enum SecurityEventKind {
  RATE_LIMIT_BLOCK
  TWO_FACTOR_BLOCK
  LOGIN_SUCCESS
  LOGIN_FAILURE
  TWO_FACTOR_REQUIRED
  TWO_FACTOR_SUCCESS
  TWO_FACTOR_FAILURE
}

model MasterIdentity {
  id     Int    @id
  userId String

  @@map("master_identity")
}

model SecurityEvent {
  id          String            @id @default(uuid())
  kind        SecurityEventKind
  clientKey   String?
  blockedUntil DateTime?
  createdAt   DateTime          @default(now())

  @@index([kind, createdAt])
  @@index([kind, blockedUntil, clientKey])
  @@index([createdAt])
  @@map("security_events")
}

enum TermType {
  USER
  ADMIN
}

enum EcoCoinTransactionType {
  CREDIT
  REDEMPTION
  REFUND
}

enum RedemptionStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model User {
  id                         String                   @id @default(uuid())
  name                       String
  cpf                        String
  cpfHash                    String?                  @unique
  birthDate                  String
  phone                      String
  cep                        String
  address                    String
  city                       String
  state                      String
  profilePhoto               String?
  jobTitle                   String?
  termsAccepted              Boolean                  @default(false)
  email                      String
  emailHash                  String?                  @unique
  password                   String
  twoFactorEnabled           Boolean                  @default(false)
  role                       Role                     @default(USER)
  active                     Boolean                  @default(true)
  pendingActivation          Boolean                  @default(false)
  deletedAt                  DateTime?
  cnpj                       String?
  addressNumber              String?
  authorizationPdf           String?
  preRegisteredById          String?
  activation                 ResidentActivation?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  termAccepts                TermAccept[]
  sessions                   Session[]
  twoFactorChallenges        TwoFactorChallenge[]
  passwordResetChallenges    PasswordResetChallenge[]
  ecoCoinBalance             Decimal                  @default(0) @db.Decimal(12, 2)
  products                   Product[]                @relation("AdminProducts")
  redemptions                Redemption[]             @relation("UserRedemptions")
  validatedRedemptions       Redemption[]             @relation("ValidatedRedemptions")
  ecoCoinTransactions        EcoCoinTransaction[]     @relation("UserEcoCoinTransactions")
  grantedEcoCoinTransactions EcoCoinTransaction[]     @relation("GrantedEcoCoinTransactions")
  salesCarts                 SalesCart[]              @relation("SellerCarts")
  purchaseCarts              SalesCart[]              @relation("BuyerCarts")

  @@map("users")
}

model Municipality {
  id      String @id @default(uuid())
  name    String
  address String
  cep     String
  cnpj    String @unique
  city    String
  state   String

  @@map("municipalities")
}

model Product {
  id          String       @id @default(uuid())
  adminId     String
  name        String
  description String
  photo       String
  barcode     String?
  price       Decimal      @db.Decimal(12, 2)
  quantity    Int
  city        String
  state       String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  admin       User         @relation("AdminProducts", fields: [adminId], references: [id])
  redemptions Redemption[]
  cartItems   SalesCartItem[]

  @@index([city, state, active])
  @@unique([city, state, barcode])
  @@index([adminId])
  @@map("products")
}

model SalesCart {
  id        String          @id @default(uuid())
  sellerId  String
  buyerId   String
  expiresAt DateTime
  seller    User            @relation("SellerCarts", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     User            @relation("BuyerCarts", fields: [buyerId], references: [id], onDelete: Cascade)
  items     SalesCartItem[]

  @@index([sellerId, expiresAt])
  @@index([buyerId])
  @@index([expiresAt])
  @@map("sales_carts")
}

model SalesCartItem {
  cartId    String
  productId String
  quantity  Int
  cart      SalesCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@id([cartId, productId])
  @@index([productId])
  @@map("sales_cart_items")
}

model ResidentActivation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  tokenHash String?
  expiresAt DateTime

  @@map("resident_activations")
}

model StoreAudit {
  id             String   @id @default(uuid())
  operation      String
  actorId        String?
  userId         String
  amount         Decimal  @db.Decimal(12, 2)
  balanceBefore  Decimal  @db.Decimal(12, 2)
  balanceAfter   Decimal  @db.Decimal(12, 2)
  redemptionId   String?
  productId      String?
  quantity       Int?
  requestKey     String?
  requestHash    String?
  cartId         String?
  createdAt      DateTime @default(now())

  @@unique([actorId, operation, requestKey])
  @@index([userId, createdAt])
  @@index([actorId, cartId])
  @@map("store_audit")
}

model StoreSaleCounter {
  day      String @id
  sequence Int

  @@map("store_sale_counters")
}

model Redemption {
  protocol      String?
  id            String           @id @default(uuid())
  cartId        String?
  userId        String
  productId     String
  quantity      Int
  unitPrice     Decimal          @db.Decimal(12, 2)
  totalPrice    Decimal          @db.Decimal(12, 2)
  pickupCode    String?          @unique
  status        RedemptionStatus @default(PENDING)
  expiresAt     DateTime
  completedAt   DateTime?
  validatedById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation("UserRedemptions", fields: [userId], references: [id])
  product       Product          @relation(fields: [productId], references: [id])
  validatedBy   User?            @relation("ValidatedRedemptions", fields: [validatedById], references: [id])

  @@index([protocol])
  @@index([userId, status])
  @@index([productId, status])
  @@index([status, expiresAt])
  @@map("redemptions")
}

model EcoCoinTransaction {
  id           String                 @id @default(uuid())
  userId       String
  grantedById  String?
  redemptionId String?
  type         EcoCoinTransactionType
  amount       Decimal                @db.Decimal(12, 2)
  description  String?
  createdAt    DateTime               @default(now())
  user         User                   @relation("UserEcoCoinTransactions", fields: [userId], references: [id])
  grantedBy    User?                  @relation("GrantedEcoCoinTransactions", fields: [grantedById], references: [id])

  @@index([userId, createdAt])
  @@index([redemptionId])
  @@map("eco_coin_transactions")
}

model PasswordResetChallenge {
  id                  String    @id @default(uuid())
  userId              String
  sessionId           String?
  codeHash            String
  codeSalt            String
  attempts            Int       @default(0)
  blockedUntil        DateTime?
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenSalt      String?
  resetTokenExpiresAt DateTime?
  consumedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([blockedUntil])
  @@index([sessionId])
  @@map("password_reset_challenges")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  browser   String?
  device    String?
  city      String?
  region    String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt, id])
  @@index([expiresAt])
  @@map("sessions")
}

model TwoFactorChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  codeSalt   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model Term {
  id         String       @id @default(uuid())
  documentId String       @unique @default(uuid())
  title      String?
  text       String
  type       TermType
  version    Int
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  accepts    TermAccept[]

  @@unique([type, version])
  @@index([type, active])
  @@map("terms")
}

model TermAccept {
  id         String   @id @default(uuid())
  userId     String
  termId     String
  accepted   Boolean  @default(true)
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  term       Term     @relation(fields: [termId], references: [id])

  @@unique([userId, termId])
  @@index([userId])
  @@index([termId])
  @@map("term_accepts")
}
