  "item": [
    {
      "name": "Autenticação pública",
      "item": [
        {
          "name": "Cadastro de usuário",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/register/user",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{nome}}\",\n  \"cpf\": \"{{cpf}}\",\n  \"birthDate\": \"1990-05-15\",\n  \"phone\": \"{{telefone}}\",\n  \"cep\": \"{{cep}}\",\n  \"address\": \"{{endereco}}\",\n  \"city\": \"{{cidade}}\",\n  \"state\": \"{{uf}}\",\n  \"termsAccepted\": true,\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\",\n  \"passwordConfirmation\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Entrar",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirmar 2FA",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/2fa/verify",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{codigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Solicitar recuperação de senha",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/password/forgot",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirmar código de recuperação",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/password/verify-code",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{codigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Redefinir senha",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/password/reset",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"password\": \"{{senha}}\",\n  \"passwordConfirmation\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
