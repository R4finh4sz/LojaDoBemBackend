  "item": [
    {
      "name": "MASTER",
      "item": [
        {
          "name": "Cadastrar vendedor",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{masterToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Operador de exemplo\",\n  \"cpf\": \"{{operatorCpf}}\",\n  \"birthDate\": \"1985-09-10\",\n  \"email\": \"{{operatorEmail}}\",\n  \"cep\": \"{{cep}}\",\n  \"address\": \"Rua de exemplo\",\n  \"city\": \"{{city}}\",\n  \"state\": \"{{state}}\",\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\",\n  \"passwordConfirmation\": \"{{password}}\",\n  \"termsAccepted\": true,\n  \"cnpj\": \"{{cnpj}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register/admin"
          }
        },
        {
          "name": "Cadastrar cooperativa",
