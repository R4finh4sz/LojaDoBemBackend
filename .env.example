# PostgreSQL e servidor local
DATABASE_URL="postgresql://postgres:senha_local@localhost:5432/loja_do_bem?schema=public"
PORT=3000
NODE_ENV=development

# Defina os dois segredos antes de iniciar. A chave de dados deve ser Base64 de 32 bytes.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
JWT_EXPIRES_IN=1h
SESSION_EXPIRES_MINUTES=60
SESSION_LOCATION_PROXY_SECRET=

# Campos obrigatórios para iniciar com o único MASTER.
MASTER_EMAIL=
MASTER_PASSWORD=

# Brevo SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ReciclaOnline

# Limites e prazos
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=6
STORE_RATE_LIMIT_MAX_ATTEMPTS=300
BRUTE_FORCE_BLOCK_MS=900000
BRUTE_FORCE_DELAY_MS=500
TWO_FACTOR_CODE_EXPIRES_MINUTES=15
TWO_FACTOR_MAX_ATTEMPTS=6
PASSWORD_RESET_CODE_EXPIRES_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_BLOCK_HOURS=6
